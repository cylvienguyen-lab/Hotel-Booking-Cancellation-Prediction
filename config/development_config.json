{
  "schema_version": 2,
  "split_id": "split_v2",
  "experiment_version": 2,
  "split_calendar": {
    "history_start": "2015-06-17",
    "test_start": "2017-04-18",
    "test_end": "2017-08-18",
    "folds": [
      {
        "fit_date": "2016-07-01",
        "val_end": "2016-09-01"
      },
      {
        "fit_date": "2016-09-01",
        "val_end": "2016-11-01"
      },
      {
        "fit_date": "2016-11-01",
        "val_end": "2017-01-01"
      },
      {
        "fit_date": "2017-01-01",
        "val_end": "2017-03-01"
      }
    ]
  },
  "training_eligibility": {
    "rule": "CutoffDate < FitDate AND LabelAvailableDate < FitDate AND ExpectedCheckoutDate < FitDate",
    "expected_checkout": "ArrivalDate + TotalNights",
    "boundary": "strictly before FitDate"
  },
  "binary_predictors": [
    "IsRepeatedGuest",
    "IsPortugalHoliday"
  ],
  "models": {
    "Dummy": {
      "strategy": "prior"
    },
    "LR": {
      "penalty": "l2",
      "C": 1,
      "solver": "lbfgs",
      "fit_intercept": true,
      "class_weight": null,
      "max_iter": 1000,
      "tol": 0.0001,
      "random_state": 42
    },
    "RF": {
      "n_estimators": 300,
      "max_depth": null,
      "min_samples_leaf": 20,
      "max_features": "sqrt",
      "criterion": "gini",
      "bootstrap": true,
      "class_weight": null,
      "random_state": 42,
      "n_jobs": 2
    },
    "XGB": {
      "n_estimators": 300,
      "learning_rate": 0.05,
      "max_depth": 3,
      "min_child_weight": 5,
      "subsample": 0.8,
      "colsample_bytree": 0.8,
      "reg_lambda": 1,
      "scale_pos_weight": 1,
      "objective": "binary:logistic",
      "eval_metric": "logloss",
      "tree_method": "hist",
      "device": "cpu",
      "random_state": 42,
      "n_jobs": 2,
      "early_stopping_rounds": null
    }
  },
  "availability_assumption": "All 30 Gold predictors are treated as available at T-14 for model development. The source lacks historical booking snapshots, so point-in-time validity is assumed, not proven. Google Trends uses a retrospective normalized export; production safety is not established."
}
