{
  "run_id": "rolling_12m_v1",
  "split_id": "split_v1",
  "models": {
    "random_forest": {
      "n_estimators": 300,
      "max_depth": null,
      "min_samples_leaf": 20,
      "max_features": "sqrt",
      "criterion": "gini",
      "bootstrap": true,
      "class_weight": null,
      "random_state": 42,
      "n_jobs": 2
    },
    "xgboost": {
      "n_estimators": 300,
      "learning_rate": 0.05,
      "max_depth": 3,
      "min_child_weight": 5,
      "subsample": 0.8,
      "colsample_bytree": 0.8,
      "reg_lambda": 1,
      "scale_pos_weight": 1,
      "objective": "binary:logistic",
      "eval_metric": "logloss",
      "tree_method": "hist",
      "device": "cpu",
      "random_state": 42,
      "n_jobs": 2,
      "early_stopping_rounds": null
    }
  },
  "feature_set": "core_no_year_month_week",
  "feature_config": {
    "numeric": [
      "LeadTime",
      "ArrivalDateDayOfMonth",
      "StaysInWeekendNights",
      "StaysInWeekNights",
      "Adults",
      "Children",
      "Babies",
      "ArrivalDayOfWeek",
      "TotalNights",
      "PartySize",
      "EURUSD"
    ],
    "binary": [
      "IsRepeatedGuest",
      "IsPortugalHoliday"
    ],
    "categorical": [
      "Meal",
      "MarketSegment",
      "DistributionChannel",
      "ReservedRoomType",
      "CustomerType"
    ]
  },
  "training_history": {
    "strategy": "rolling",
    "lookback_months": 12,
    "rule": "FitDate - 12 calendar months <= CutoffDate < FitDate and LabelAvailableDate < FitDate"
  },
  "preprocessing": {
    "numeric_scaling": false,
    "numeric_imputation": "median",
    "binary_imputation": "most_frequent",
    "categorical_imputation": "__MISSING__",
    "categorical_encoding": "one_hot",
    "handle_unknown": "ignore"
  },
  "evaluation": {
    "primary_metric": "LogLoss",
    "primary_direction": "minimize",
    "metrics": [
      "LogLoss",
      "BrierScore",
      "ROC_AUC",
      "AveragePrecision"
    ],
    "cv_aggregation": "equal_weight_mean_of_validation_windows"
  },
  "environment": {
    "python": "3.12.15",
    "numpy": "2.2.2",
    "pandas": "2.2.3",
    "scikit_learn": "1.6.1",
