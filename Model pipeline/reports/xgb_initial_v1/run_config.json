{
  "run_id": "xgb_initial_v1",
  "split_id": "split_v1",
  "model": "xgboost",
  "model_params": {
    "n_estimators": 300,
    "learning_rate": 0.05,
    "max_depth": 3,
    "min_child_weight": 5,
    "subsample": 0.8,
    "colsample_bytree": 0.8,
    "reg_lambda": 1,
